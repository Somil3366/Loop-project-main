# Copy this file to .env.local and fill in real values. Never commit this
# file. Next.js loads .env.local automatically for the app itself; the
# Prisma CLI (migrate/seed/studio) loads it too, via prisma.config.ts.
# (A plain .env also still works as a fallback if you already use one.)

# PostgreSQL connection string (Neon or Supabase free tier both work).
# Neon example:     postgresql://user:password@ep-xxxx.region.aws.neon.tech/loop?sslmode=require
# Supabase example: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/loop_dev?schema=public"

# NextAuth session encryption secret. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-generated-secret"

# Base URL NextAuth uses for callbacks. http://localhost:3000 in development;
# your production URL (e.g. https://loop-yourname.vercel.app) once deployed.
NEXTAUTH_URL="http://localhost:3000"

# Anthropic API key. Sentiment/theme classification runs locally now (see
# lib/local-classifier.ts) and does NOT need this. Only Ask LOOP's answer
# generation and the VoC report narrative still call Claude and need this
# key set - leave it unset if you're not using those two features yet.
ANTHROPIC_API_KEY="sk-ant-..."

# Voyage AI API key - Anthropic's own documented recommendation for
# embeddings, since Claude has no native embedding model (Section 05 allows
# "pgvector or a hosted embeddings provider"; this is that provider). Used
# from Milestone 3 onward for Ask LOOP's semantic search. Get a key at
# https://dashboard.voyageai.com
VOYAGE_API_KEY="pa-..."
